+    expect(subscribed(["ticket.*"], "ticket.signed")).toBe(true);
+    expect(subscribed(["ticket.signed"], "ticket.signed")).toBe(true);
+    expect(subscribed(["invoice.*"], "ticket.signed")).toBe(false);
+    expect(subscribed(["*"], "anything")).toBe(true);
+  });
+});
+
