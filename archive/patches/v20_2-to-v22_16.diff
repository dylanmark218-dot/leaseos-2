+      if (!decision.allowed) {
+        throw new TRPCError({
+          code:
+            decision.outcome === "denied_unauthenticated"
+              ? "UNAUTHORIZED"
+              : "FORBIDDEN",
+          // Named, like every other gate in the system. "Not permitted" tells
+          // an operator nothing they can act on.
+          message: decision.detail ?? `Requires ${permission}`,
+        });
+      }
