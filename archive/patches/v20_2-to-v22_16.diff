+      for (const inv of invoiceRows) if (inv.billingBookId != null && bookIds.includes(inv.billingBookId)) invoicesByBook.set(inv.billingBookId, [...(invoicesByBook.get(inv.billingBookId) ?? []), inv.invoiceNumber]);
