+  CONSTRAINT `operatorEquipmentAuthorizations_id` PRIMARY KEY(`id`),
+  CONSTRAINT `operatorEquipmentAuthorizations_ref_unique` UNIQUE(`authorizationRef`)
+);
+--> statement-breakpoint
