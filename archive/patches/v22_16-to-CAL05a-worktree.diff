+  `verifiedByUserId` int,
+  `verifiedAt` timestamp NULL,
+  `documentRef` varchar(64),
+  `supersededByHoldingRef` varchar(64),
+  `recordedByUserId` int NOT NULL,
+  `recordedAt` timestamp NOT NULL,
