+  /** Messages in a channel, oldest first, with both clocks intact. */
+  read: roleProcedure("board.read")
+    .input(z.object({ channelRef: z.string().min(1).max(64), asClientRef: z.string().max(64).optional() }))
+    .query(async ({ ctx, input }) => {
