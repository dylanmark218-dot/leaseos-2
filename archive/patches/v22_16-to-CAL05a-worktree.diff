+  `expiresAt` timestamp NOT NULL,
+  `revokedAt` timestamp NULL,
+  `revokedByUserId` int,
+  `revocationReason` varchar(400),
+  `viewCount` int NOT NULL DEFAULT 0,
+  `lastViewedAt` timestamp NULL,
+  `createdAt` timestamp NOT NULL DEFAULT (now()),
