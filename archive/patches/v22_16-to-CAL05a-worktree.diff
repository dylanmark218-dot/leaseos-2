+    expect(SENSITIVE_PERMISSIONS).toContain("board.manage");
+    expect(SENSITIVE_PERMISSIONS).not.toContain("board.post");
+    expect(SENSITIVE_PERMISSIONS).not.toContain("board.read");
+  });
+});
